generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model atividade {
  id_atividade           Int                     @id @default(autoincrement()) @db.UnsignedMediumInt
  nome                   String                  @db.VarChar(100)
  tipo                   String?                 @db.VarChar(50)
  descricao              String?                 @db.VarChar(255)
  observacao             String?                 @db.VarChar(200)
  limite                 Int?                    @db.UnsignedSmallInt
  fk_sala                Int?                    @db.UnsignedTinyInt
  fk_evento              Int                     @db.UnsignedSmallInt
  fk_atividade_vinculada Int?                    @db.UnsignedMediumInt
  evento                 evento                  @relation(fields: [fk_evento], references: [id_evento], onDelete: NoAction, onUpdate: NoAction, map: "fk_atividade_evento1")
  sala                   sala?                   @relation(fields: [fk_sala], references: [id_sala], onDelete: NoAction, onUpdate: NoAction, map: "fk_atividade_sala1")
  atividade_vinculada    atividade?              @relation("AtividadeVinculada", fields: [fk_atividade_vinculada], references: [id_atividade], onDelete: NoAction, onUpdate: NoAction, map: "fk_atividade_atividade1")
  atividades_filhas      atividade[]             @relation("AtividadeVinculada")
  data_atividade         data_atividade[]
  palestrante_atividade  palestrante_atividade[]

  @@index([fk_evento], map: "fk_atividade_evento1_idx")
  @@index([fk_sala], map: "fk_atividade_sala1_idx")
  @@index([fk_atividade_vinculada], map: "fk_atividade_atividade1_idx")
}

model certificado {
  nome            String       @db.VarChar(15)
  fk_participante Int          @id @db.UnsignedInt
  participante    participante @relation(fields: [fk_participante], references: [id_participante], onUpdate: Restrict, map: "certificado_ibfk_2")

  @@index([fk_participante], map: "fk_participante")
}

model data_atividade {
  id_data_atividade           Int                           @id @default(autoincrement()) @db.UnsignedInt
  data                        DateTime                      @db.Date
  hora                        DateTime                      @db.Time(0)
  duracao                     DateTime?                     @db.Time(0)
  intervalo                   DateTime?                     @db.Time(0)
  fk_atividade                Int                           @db.UnsignedMediumInt
  senha                       String?                       @db.VarChar(100)
  qrcode                      String?                       @db.VarChar(200)
  atividade                   atividade                     @relation(fields: [fk_atividade], references: [id_atividade], onDelete: NoAction, onUpdate: NoAction, map: "fk_data_atividade_atividade1")
  data_atividade_participante data_atividade_participante[]

  @@index([fk_atividade], map: "fk_data_atividade_atividade1")
}

model data_atividade_participante {
  fk_data_atividade Int            @db.UnsignedInt
  fk_participante   Int            @db.UnsignedInt
  presenca          Int?           @db.TinyInt
  data_hora         DateTime?      @db.DateTime(0)
  data_atividade    data_atividade @relation(fields: [fk_data_atividade], references: [id_data_atividade], onDelete: NoAction, onUpdate: NoAction, map: "fk_data_atividade_has_participante_data_atividade1")
  participante      participante   @relation(fields: [fk_participante], references: [id_participante], onDelete: NoAction, onUpdate: NoAction, map: "fk_data_atividade_has_participante_participante1")

  @@id([fk_data_atividade, fk_participante])
  @@index([fk_data_atividade], map: "fk_data_atividade_has_participante_data_atividade1_idx")
  @@index([fk_participante], map: "fk_data_atividade_has_participante_participante1_idx")
}

model evento {
  id_evento           Int                   @id @default(autoincrement()) @db.UnsignedSmallInt
  nome                String                @db.VarChar(100)
  inicio              DateTime              @db.Date
  final               DateTime              @db.Date
  ano                 Int                   @db.Year
  slug                String?               @db.VarChar(100)
  banner              String?               @db.VarChar(255)
  cor_primaria        String?               @db.VarChar(20)
  cor_secundaria      String?               @db.VarChar(20)
  base_url             String?               @db.VarChar(255)
  fk_usuario_responsavel Int?                  @db.UnsignedInt
  fk_evento_pai       Int?                  @db.UnsignedSmallInt
  atividade            atividade[]
  evento_participante  evento_participante[]
  palestrante_evento   palestrante_evento[]
  usuario_responsavel  usuario?              @relation("EventoResponsavel", fields: [fk_usuario_responsavel], references: [id_usuario], onDelete: SetNull, onUpdate: Cascade)
  evento_pai          evento?               @relation("EventosFilhos", fields: [fk_evento_pai], references: [id_evento], onDelete: SetNull, onUpdate: Cascade, map: "fk_evento_evento_pai")
  eventos_filhos      evento[]              @relation("EventosFilhos")

  @@index([fk_evento_pai], map: "fk_evento_evento_pai_idx")
}

model evento_participante {
  fk_evento       Int          @db.UnsignedSmallInt
  fk_participante Int          @db.UnsignedInt
  evento          evento       @relation(fields: [fk_evento], references: [id_evento], onDelete: NoAction, onUpdate: NoAction, map: "fk_evento_has_participante_evento1")
  participante    participante @relation(fields: [fk_participante], references: [id_participante], onDelete: NoAction, onUpdate: NoAction, map: "fk_evento_has_participante_participante1")

  @@id([fk_evento, fk_participante])
  @@index([fk_evento], map: "fk_evento_has_participante_evento1_idx")
  @@index([fk_participante], map: "fk_evento_has_participante_participante1_idx")
}

model palestrante {
  id_palestrante        Int                     @id @default(autoincrement()) @db.UnsignedSmallInt
  nome                  String                  @db.VarChar(70)
  email                 String                  @db.VarChar(100)
  instituicao           String?                 @db.VarChar(100)
  foto                  String?                 @db.VarChar(70)
  palestrante_atividade palestrante_atividade[]
  palestrante_evento    palestrante_evento[]
}

model palestrante_evento {
  fk_palestrante Int         @db.UnsignedSmallInt
  fk_evento      Int         @db.UnsignedSmallInt
  palestrante    palestrante @relation(fields: [fk_palestrante], references: [id_palestrante], onDelete: Cascade, onUpdate: NoAction, map: "fk_palestrante_evento_palestrante")
  evento         evento      @relation(fields: [fk_evento], references: [id_evento], onDelete: Cascade, onUpdate: NoAction, map: "fk_palestrante_evento_evento")

  @@id([fk_palestrante, fk_evento])
  @@index([fk_evento], map: "fk_palestrante_evento_evento_idx")
  @@index([fk_palestrante], map: "fk_palestrante_evento_palestrante_idx")
}

model palestrante_atividade {
  fk_atividade   Int         @db.UnsignedMediumInt
  fk_palestrante Int         @db.UnsignedSmallInt
  palestrante    palestrante @relation(fields: [fk_palestrante], references: [id_palestrante], onDelete: NoAction, onUpdate: NoAction, map: "fk_palestrante_atividade_palestrante1")
  atividade      atividade   @relation(fields: [fk_atividade], references: [id_atividade], onDelete: NoAction, onUpdate: NoAction, map: "fk_palestrante_has_atividade_atividade1")

  @@id([fk_atividade, fk_palestrante])
  @@index([fk_palestrante], map: "fk_palestrante_atividade_palestrante1_idx")
  @@index([fk_atividade], map: "fk_palestrante_has_atividade_atividade1_idx")
}

model participante {
  id_participante             Int                           @id @default(autoincrement()) @db.UnsignedInt
  fk_turma                    Int?                          @db.UnsignedTinyInt
  fk_usuario                  Int                           @db.UnsignedInt
  fk_turno                    Int?                          @db.UnsignedTinyInt
  semestre                    Int?                          @db.UnsignedTinyInt
  certificado                 certificado?
  data_atividade_participante data_atividade_participante[]
  evento_participante         evento_participante[]
  participante_turma          participante_turma[]
  turma                       turma?                        @relation(fields: [fk_turma], references: [id_turma], onDelete: NoAction, onUpdate: NoAction, map: "fk_participante_turma1")
  turno                       turno?                        @relation(fields: [fk_turno], references: [id_turno], onDelete: NoAction, onUpdate: NoAction, map: "fk_participante_turno1")
  usuario                     usuario                       @relation(fields: [fk_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_participante_usuario1")

  @@index([fk_turma], map: "fk_participante_turma1_idx")
  @@index([fk_turno], map: "fk_participante_turno1_idx")
  @@index([fk_usuario], map: "fk_participante_usuario1_idx")
}

model sala {
  id_sala   Int         @id @default(autoincrement()) @db.UnsignedTinyInt
  nome      String      @db.VarChar(45)
  atividade atividade[]
}

model turma {
  id_turma     Int            @id @default(autoincrement()) @db.UnsignedTinyInt
  nome         String         @unique(map: "nome_UNIQUE") @db.VarChar(25)
  participante participante[]
  participante_turma participante_turma[]
}

model turno {
  id_turno     Int            @id @default(autoincrement()) @db.UnsignedTinyInt
  nome         String         @db.VarChar(15)
  participante participante[]
}

model usuario {
  id_usuario          Int            @id @default(autoincrement()) @db.UnsignedInt
  nome                String         @db.VarChar(70)
  cpf                 String         @unique(map: "cpf_UNIQUE") @db.Char(11)
  email               String         @unique(map: "email_UNIQUE") @db.VarChar(100)
  senha               String         @db.VarChar(255)
  ra                  Int?           @db.UnsignedMediumInt
  tipo                Int?           @db.TinyInt
  vinculo             Int?           @db.TinyInt
  modificado          DateTime?      @default(now()) @db.Timestamp(0)
  comunidade          String?        @db.VarChar(70)
  instituicao         String?        @db.VarChar(70)
  siape               String?        @db.VarChar(20)
  reset_token         String?        @db.VarChar(255)
  reset_token_expires DateTime?      @db.DateTime(0)
  primeiro_acesso     Boolean        @default(true)
  participante        participante[]
  eventos_responsavel evento[]       @relation("EventoResponsavel")
}

model participante_turma {
  fk_participante Int          @db.UnsignedInt
  fk_turma        Int          @db.UnsignedTinyInt
  participante    participante @relation(fields: [fk_participante], references: [id_participante], onDelete: Cascade)
  turma           turma        @relation(fields: [fk_turma], references: [id_turma], onDelete: Cascade)

  @@id([fk_participante, fk_turma])
  @@index([fk_participante])
  @@index([fk_turma])
}
